APP_VERSION=latest

DJANGO_SECRET_KEY=change-me-please-use-openssl-rand-hex-32
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,wazuh-ti.example.internal
DJANGO_CSRF_TRUSTED_ORIGINS=https://wazuh-ti.example.internal

POSTGRES_DB=wazuh_ti
POSTGRES_USER=wazuh_ti
POSTGRES_PASSWORD=wazuh_ti_password
DATABASE_URL=postgresql://wazuh_ti:wazuh_ti_password@postgres:5432/wazuh_ti

REDIS_URL=redis://redis:6379/0

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.internal
DJANGO_SUPERUSER_PASSWORD=change-me-admin

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Initial TI configuration bootstrap.
# These values are applied only when TiConfiguration does not exist yet.
WAZUH_TI_EXPORT_API_TOKEN=change-me-export-token
WAZUH_TI_TAXII_URL=https://opencti.example.internal/taxii2/root/collections/<collection-id>/
WAZUH_TI_RETROHUNT_QUEUE_EXISTING_ON_FIRST_RUN=false
WAZUH_TI_WAZUH_INDEXER_URL=https://wazuh-indexer.example.internal:9200
WAZUH_TI_WAZUH_INDEXER_USERNAME=admin
WAZUH_TI_WAZUH_INDEXER_PASSWORD=change-me-indexer-password
WAZUH_TI_WAZUH_INDEXER_VERIFY_TLS=false